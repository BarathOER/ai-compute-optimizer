# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Service ---
APP_NAME=AI Compute Optimizer
LOG_LEVEL=INFO

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Semantic cache (ChromaDB) ---
# Leave CHROMA_HOST unset to use a local persistent store at CHROMA_PERSIST_DIR.
# In docker-compose it is set to the `chromadb` service.
# CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=semantic_cache

# --- Two-stage retrieval ---
# Stage 1 (bi-encoder cosine) is a RECALL filter that picks rerank candidates.
STAGE1_THRESHOLD=0.70
RERANK_TOP_K=5
# Stage 2 (cross-encoder) decides the hit. Set ENABLE_RERANKER=false to A/B
# test the old bi-encoder-only behaviour. RERANKER_THRESHOLD is an empirical
# cut point for this model, NOT a probability (re-tune via eval/two_stage_eval.py).
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/quora-distilroberta-base
RERANKER_THRESHOLD=0.943

# --- Router ---
COMPLEXITY_WORD_THRESHOLD=40
# Set ENABLE_LOCAL_ROUTE=false on cloud deploys with no Ollama: every cache
# miss then routes to Gemini. Keep true for local/Docker (full local+remote).
ENABLE_LOCAL_ROUTE=true

# --- Ollama (local model) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=60

# --- Gemini (remote model) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Cost model (USD per 1M tokens) ---
# Input and output tokens are billed separately; output is ~6x input.
# Defaults reflect Gemini 3.5 Flash list pricing (verified July 2026).
REMOTE_INPUT_COST_PER_1M=1.50
REMOTE_OUTPUT_COST_PER_1M=9.00
LOCAL_INPUT_COST_PER_1M=0.0
LOCAL_OUTPUT_COST_PER_1M=0.0

# --- Savings projection ---
# Assumed production volume used to project monthly/annual savings.
PROJECTED_MONTHLY_QUERIES=100000
