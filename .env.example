# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Service ---
APP_NAME=AI Compute Optimizer
LOG_LEVEL=INFO

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Semantic cache (ChromaDB) ---
# Leave CHROMA_HOST unset to use a local persistent store at CHROMA_PERSIST_DIR.
# In docker-compose it is set to the `chromadb` service.
# CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=semantic_cache
SIMILARITY_THRESHOLD=0.85

# --- Router ---
COMPLEXITY_WORD_THRESHOLD=40

# --- Ollama (local model) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=60

# --- Gemini (remote model) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Cost model (USD per 1M tokens) ---
# Input and output tokens are billed separately; output is ~6x input.
# Defaults reflect Gemini 3.5 Flash list pricing (verified July 2026).
REMOTE_INPUT_COST_PER_1M=1.50
REMOTE_OUTPUT_COST_PER_1M=9.00
LOCAL_INPUT_COST_PER_1M=0.0
LOCAL_OUTPUT_COST_PER_1M=0.0

# --- Savings projection ---
# Assumed production volume used to project monthly/annual savings.
PROJECTED_MONTHLY_QUERIES=100000
